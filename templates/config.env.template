# ============================================================
# HomeBridge - config.env.template
# ============================================================
# This file lists every key a config.env needs and documents
# what it's for. It intentionally does NOT ship machine-specific
# defaults anymore (ports, task names, Windows user) because those
# must be unique per physical machine to avoid silent collisions
# on the shared relay (e.g. two machines fighting over the same
# reverse tunnel port).
#
# Do NOT copy this file directly to config.env.
# Instead, start from the isolated file for your machine:
#   - config.env.papa   -> papa-windows
#   - config.env.fille  -> fille-windows
# Copy the right one to config.env next to the script you run,
# then adjust RELAY_IP/RELAY_USER if needed.
# ============================================================

# Relay server IP or domain (shared, same value in every machine's config.env)
RELAY_IP=172.234.175.48

# User created on the relay for the reverse tunnel (shared)
RELAY_USER=tunnel

# ====================================================================
# RDP Configuration (HomeBridge v1.0) - PER MACHINE, see config.env.<machine>
# ====================================================================

# Port used for the reverse tunnel (unique per machine - see config.env.papa / config.env.fille)
REVERSE_PORT=

# Local SSH port on Windows (shared, standard OpenSSH port)
LOCAL_SSH_PORT=22

# Name of the scheduled task on Windows (unique per machine)
TASK_NAME=

# Windows user for RDP connection (unique per machine)
WINDOWS_USER=

# Windows RDP port (shared, standard RDP port)
WINDOWS_RDP_PORT=3389

# Local port used for the RDP tunnel on the client side (unique per machine)
LOCAL_RDP_PORT=

# ====================================================================
# VNC Configuration (HomeBridge v1.1) - PER MACHINE, see config.env.<machine>
# ====================================================================

# VNC reverse tunnel port (unique per machine - was fixed at 15900 for every
# machine, which is exactly the silent collision this file now prevents)
VNC_REVERSE_PORT=

# VNC local port on Windows (shared, standard VNC port)
VNC_LOCAL_PORT=5900

# VNC client local port (Linux side) - must match VNC_REVERSE_PORT for that machine
VNC_CLIENT_LOCAL_PORT=

# Name of the VNC scheduled task (unique per machine)
VNC_TASK_NAME=
