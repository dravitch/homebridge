# ============================================================
# HomeBridge - config.env.fille
# Isolated configuration for fille-windows (v1.1+)
# Copy this file to config.env on fille-windows.
#
# Every value that must be unique per machine (ports, task
# names, Windows user) is set to a distinct value from
# config.env.papa on purpose, to eliminate the silent
# resource collisions between papa-windows and fille-windows
# (most notably VNC_REVERSE_PORT, which used to be hardcoded
# to 15900 for every machine).
# ============================================================

# Relay server IP or domain
RELAY_IP=172.234.175.48

# User created on the relay for the reverse tunnel
RELAY_USER=tunnel

# ====================================================================
# RDP Configuration (HomeBridge v1.0)
# ====================================================================

# Port used for the reverse tunnel (unique per machine)
REVERSE_PORT=2223

# Local SSH port on Windows
LOCAL_SSH_PORT=22

# Name of the scheduled task on Windows
TASK_NAME=SSH-Reverse-Tunnel-2

# Windows user for RDP connection
WINDOWS_USER=tunnel

# Windows RDP port
WINDOWS_RDP_PORT=3389

# Local port used for the RDP tunnel on the client side
LOCAL_RDP_PORT=13390

# ====================================================================
# VNC Configuration (HomeBridge v1.1)
# ====================================================================

# VNC reverse tunnel port (unique per machine)
VNC_REVERSE_PORT=15901

# VNC local port on Windows (standard VNC)
VNC_LOCAL_PORT=5900

# VNC client local port (Linux side) - must match VNC_REVERSE_PORT above
VNC_CLIENT_LOCAL_PORT=15901

# Name of the VNC scheduled task
VNC_TASK_NAME=SSH-Reverse-Tunnel-VNC-2
